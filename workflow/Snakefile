###############################################################
# --- 7. Obtain the final target & Download Data cleanup --- #
##############################################################
rule all:
    input:
        get_final_outputs(include_multiqc=True)

onsuccess:
    cleanup_downloaded_fastqs(config)
    print("Workflow finished successfully!")

onerror:
    print("Workflow failed. Temporary files were NOT removed to aid debugging.")