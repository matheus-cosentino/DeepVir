##################################
# --- 1. Load Configuration --- #
#################################
# Use absolute path derived from the Snakefile location so configfile: is found
# regardless of --directory (Snakemake working dir). This allows running from
# a scratch directory on HPC without breaking config resolution.
import os as _os
_PROJECT_ROOT = _os.path.normpath(_os.path.join(_os.path.dirname(workflow.snakefile), ".."))
configfile: _os.path.join(_PROJECT_ROOT, "config", "config.yaml")

###########################################
# --- 2. Import functions to be used --- #
##########################################
import os
import ast 
from glob import glob
from scripts.functions import get_final_outputs
from scripts.functions import cleanup_downloaded_fastqs
from scripts.functions import filter_nohits
from scripts.functions import identify_data_type
from scripts.functions import get_input_r1
from scripts.functions import get_input_r2
from scripts.functions import get_input_unp
from scripts.functions import get_contigs_path
from scripts.functions import get_denovo_r1
from scripts.functions import get_denovo_r2
from scripts.functions import get_denovo_unpaired
from scripts.functions import get_ONP_input
from scripts.functions import get_spades_params
from scripts.functions import get_megahit_params
from scripts.functions import get_sra_layout
from scripts.functions import get_diamond_db_input
from scripts.functions import get_diamond_db_name
from scripts.functions import get_header_check
from scripts.functions import get_multiqc_inputs
from scripts.functions import get_all_kraken_reports

###########################################################
# --- 3. Define workflown directory and local infos  --- #
##########################################################
WORKDIR = config["workdir"]
DATA = config["data_dir"]
OUT_DIR = config["output_dir"]
KRONA_DB_DIR = [_os.path.join(_PROJECT_ROOT, p) for p in config["resources"]["krona"]]
TAXONOMY_DIR = [_os.path.join(_PROJECT_ROOT, p) for p in config["resources"]["taxonomy"]]
RVDB_DIR = [_os.path.join(_PROJECT_ROOT, p) for p in config["resources"]["rvdb"]]
MEGAN_DIR = [_os.path.join(_PROJECT_ROOT, p) for p in config["resources"]["megan"]]
# Absolute path to the resources directory — needed when --directory points to scratch,
# where relative paths like "resources/diamond/" would resolve to the wrong location.
RESOURCES_DIR = _os.path.join(_PROJECT_ROOT, "resources")

with open(config["sample_list"], "r") as file:
    SAMPLE = [line.strip() for line in file if line.strip()]

# Guard: if the sample name is a subdirectory inside data_dir, skip it.
# This prevents folders (e.g. per-sample BCL2FASTQ dirs) from being
# mistakenly queued as SRA downloads.
_filtered_sample = []
for sample in SAMPLE:
    if os.path.isdir(os.path.join(DATA, sample)):
        print(f"[WARNING] '{sample}' is a directory inside '{DATA}' — skipping.")
        continue
    _filtered_sample.append(sample)
SAMPLE = _filtered_sample

SAMPLE_META = identify_data_type(SAMPLE, DATA)

# Remove from SAMPLE any entry that identify_data_type chose to skip
# (e.g. names that are subdirectories in DATA rather than actual sample files).
_skipped = [s for s in SAMPLE if s not in SAMPLE_META]
if _skipped:
    print(f"[INFO] Removing {len(_skipped)} skipped sample(s) from the active list: {_skipped}")
SAMPLE = [s for s in SAMPLE if s in SAMPLE_META]

############################################
# --- 4. Export functions to be used.  --- #
###########################################
import scripts.functions as functions

if isinstance(config["modules"], str):
    try:
        config["modules"] = ast.literal_eval(config["modules"])
    except (ValueError, SyntaxError):
        print("[ERROR] Could not parse 'modules' configuration string.")
        raise

functions.DATA = DATA
functions.SAMPLE = SAMPLE
functions.OUT_DIR = OUT_DIR
functions.SAMPLE_META = SAMPLE_META
functions.MAPPER = config["tool"]["denovo"] 
functions.MODULES = config["modules"]
functions.get_final_outputs = get_final_outputs
functions.cleanup_downloaded_fastqs = cleanup_downloaded_fastqs
functions.filter_nohits = filter_nohits
functions.identify_data_type = identify_data_type
functions.get_input_r1 = get_input_r1
functions.get_input_r2 = get_input_r2
functions.get_input_unp = get_input_unp
functions.get_contigs_path = get_contigs_path
functions.get_denovo_r1 = get_denovo_r1
functions.get_denovo_r2 = get_denovo_r2
functions.get_denovo_unpaired = get_denovo_unpaired
functions.get_ONP_input = get_ONP_input
functions.get_spades_params = get_spades_params
functions.get_megahit_params = get_megahit_params
functions.get_sra_layout = get_sra_layout
functions.get_header_check = get_header_check
functions.get_multiqc_inputs = get_multiqc_inputs 
functions.get_all_kraken_reports = get_all_kraken_reports
functions.config = config

##############################################
