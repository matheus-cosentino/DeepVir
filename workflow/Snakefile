#######################################
# --- 6. Load the Workflow Rules --- #
######################################

include: "rules/get_data.smk"
include: "rules/fastp.smk"
include: "rules/denovo.smk"
include: "rules/diamond.smk"
include: "rules/kraken2.smk"
